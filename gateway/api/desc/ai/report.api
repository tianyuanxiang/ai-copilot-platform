// 生成指定日期安全日报请求。
type AiDailyReportReq {
	date string `json:"date"`
}

// 查询安全日报列表参数。
type AiDailyReportQueryReq {
	page int `form:"page,optional"`
	pageSize int `form:"pageSize,optional"`
	startDate string `form:"startDate,optional"`
	endDate string `form:"endDate,optional"`
	status string `form:"status,optional"`
}

// 安全日报路径参数。
type AiDailyReportPathReq {
	reportId int64 `path:"reportId"`
}

// 安全日报内容和核心统计指标。
type AiDailyReportItem {
	reportId int64 `json:"reportId"`
	date string `json:"date"`
	title string `json:"title"`
	content string `json:"content"`
	status string `json:"status"`
	failedLoginCount int64 `json:"failedLoginCount"`
	successLoginCount int64 `json:"successLoginCount"`
	alertCount int64 `json:"alertCount"`
	topIps []AiTopCountItem `json:"topIps"`
	topUsers []AiTopCountItem `json:"topUsers"`
	createdAt string `json:"createdAt"`
}

// 单份安全日报响应。
type AiDailyReportResp {
	report AiDailyReportItem `json:"report"`
}

// 安全日报分页列表响应。
type AiListDailyReportResp {
	total int64 `json:"total"`
	list []AiDailyReportItem `json:"list"`
}

@server (
	group: ai_report
	prefix: /api/v1/ai
)
service gateway {
	// 生成指定日期的 AI 安全日报。
	@handler aiGenerateDailyReport
	post /reports/daily/generate (AiDailyReportReq) returns (AiDailyReportResp)

	// 查询 AI 安全日报列表。
	@handler aiListDailyReport
	get /reports/daily (AiDailyReportQueryReq) returns (AiListDailyReportResp)

	// 查询单份 AI 安全日报详情。
	@handler aiGetDailyReport
	get /reports/daily/:reportId (AiDailyReportPathReq) returns (AiDailyReportResp)
}
