// 风机 Agent、工具调用日志和工单草稿接口。

type AiWindTicketDraftReq {
	farmCode string `json:"farmCode"`
	towerCode string `json:"towerCode,optional"`
	alarmCode string `json:"alarmCode,optional"`
	evidenceJson string `json:"evidenceJson,optional"`
}

type AiWindAgentRunReq {
	conversationId string `json:"conversationId,optional"`
	input string `json:"input"`
}

type AiWindAgentRunResp {
	answer string `json:"answer"`
	traceId string `json:"traceId"`
	toolCalls []AiWindToolCallItem `json:"toolCalls"`
}

type AiWindListToolCallReq {
	page int `form:"page,optional"`
	pageSize int `form:"pageSize,optional"`
	traceId string `form:"traceId,optional"`
	toolName string `form:"toolName,optional"`
	status string `form:"status,optional"`
}

type AiWindListToolCallResp {
	total int64 `json:"total"`
	list []AiWindToolCallItem `json:"list"`
}

@server (
	group: ai_wind_agent
	prefix: /api/v1/ai/wind
	middleware: AuthMiddleware,CasbinMiddleware
)
service gateway {
    // 运维智能助手
    @handler aiWindCopilotAgent
    post /agent/stream (AiWindAgentRunReq)

	// 创建维修工单草稿，一期返回可编辑草稿结构。
	@handler aiWindCreateTicketDraft
	post /tickets/draft (AiWindTicketDraftReq) returns (AiWindScaffoldResp)

	// 运行受控 Agent，一期只返回工具白名单和 trace。
	@handler aiWindRunAgent
	post /agent/run (AiWindAgentRunReq) returns (AiWindAgentRunResp)

	// 查询工具调用日志。
	@handler aiWindListToolCalls
	get /agent/tool-calls (AiWindListToolCallReq) returns (AiWindListToolCallResp)
}
