// 风机健康报告接口。

type AiWindHealthReportReq {
	reportType string `json:"reportType,optional"`
	farmCode string `json:"farmCode"`
	towerCode string `json:"towerCode,optional"`
	startTime string `json:"startTime,optional"`
	endTime string `json:"endTime,optional"`
	evidenceJson string `json:"evidenceJson,optional"`
}

type AiWindHealthReportPathReq {
	reportId int64 `path:"reportId"`
}

@server (
	group: ai_wind_report
	prefix: /api/v1/ai/wind
)
service gateway {
	// 生成健康报告草稿，一期保留章节和 evidence 结构。
	@handler aiWindGenerateHealthReport
	post /reports/health/generate (AiWindHealthReportReq) returns (AiWindScaffoldResp)

	// 查询健康报告草稿。
	@handler aiWindGetHealthReport
	get /reports/health/:reportId (AiWindHealthReportPathReq) returns (AiWindScaffoldResp)
}
