// 公共知识库成员信息，role 可取 viewer/editor/manager。
type AiKbMemberItem {
	kbId int64 `json:"kbId"`
	userId int64 `json:"userId"`
	username string `json:"username"`
	nickname string `json:"nickname"`
	role string `json:"role"`
	createdAt string `json:"createdAt"`
}

// 查询公共知识库成员列表参数。
type AiListKbMemberReq {
	kbId int64 `path:"kbId"`
	page int `form:"page,optional"`
	pageSize int `form:"pageSize,optional"`
	keyword string `form:"keyword,optional"`
	role string `form:"role,optional"`
}

// 公共知识库成员分页列表响应。
type AiListKbMemberResp {
	total int64 `json:"total"`
	list []AiKbMemberItem `json:"list"`
}

// 添加公共知识库成员请求。
type AiAddKbMemberReq {
	kbId int64 `path:"kbId"`
	userId int64 `json:"userId"`
	role string `json:"role"`
}

// 更新公共知识库成员角色请求。
type AiUpdateKbMemberReq {
	kbId int64 `path:"kbId"`
	userId int64 `path:"userId"`
	role string `json:"role"`
}

// 公共知识库成员路径参数。
type AiKbMemberPathReq {
	kbId int64 `path:"kbId"`
	userId int64 `path:"userId"`
}

@server (
	group: ai_kb_member
	prefix: /api/v1/ai
)
service gateway {
	// 查询公共知识库成员列表。
	@handler aiListKbMember
	get /kb/public/:kbId/members (AiListKbMemberReq) returns (AiListKbMemberResp)

	// 添加公共知识库成员并授予角色。
	@handler aiAddKbMember
	post /kb/public/:kbId/members (AiAddKbMemberReq) returns (AiCommonResp)

	// 调整公共知识库成员角色。
	@handler aiUpdateKbMember
	put /kb/public/:kbId/members/:userId (AiUpdateKbMemberReq) returns (AiCommonResp)

	// 移除公共知识库成员。
	@handler aiRemoveKbMember
	delete /kb/public/:kbId/members/:userId (AiKbMemberPathReq) returns (AiCommonResp)
}
