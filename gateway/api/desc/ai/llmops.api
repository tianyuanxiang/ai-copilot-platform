// LLM 调用日志项，用于 trace 追踪和 token 成本统计。
type AiLlmCallItem {
	traceId string `json:"traceId"`
	provider string `json:"provider"`
	model string `json:"model"`
	promptTokens int64 `json:"promptTokens"`
	completionTokens int64 `json:"completionTokens"`
	latencyMs int64 `json:"latencyMs"`
	status string `json:"status"`
	errorMsg string `json:"errorMsg"`
	createdAt string `json:"createdAt"`
}

// LLM trace 路径参数。
type AiLlmTracePathReq {
	traceId string `path:"traceId"`
}

// 指定 trace 下的 LLM 调用明细响应。
type AiLlmTraceResp {
	traceId string `json:"traceId"`
	calls []AiLlmCallItem `json:"calls"`
}

// 查询 LLM 调用日志列表参数。
type AiListLlmCallReq {
	page int `form:"page,optional"`
	pageSize int `form:"pageSize,optional"`
	traceId string `form:"traceId,optional"`
	provider string `form:"provider,optional"`
	model string `form:"model,optional"`
	status string `form:"status,optional"`
	startTime string `form:"startTime,optional"`
	endTime string `form:"endTime,optional"`
}

// LLM 调用日志分页列表响应。
type AiListLlmCallResp {
	total int64 `json:"total"`
	list []AiLlmCallItem `json:"list"`
}

// 查询 token 统计参数。
type AiTokenStatsReq {
	startTime string `form:"startTime,optional"`
	endTime string `form:"endTime,optional"`
	provider string `form:"provider,optional"`
	model string `form:"model,optional"`
}

// token 用量统计响应。
type AiTokenStatsResp {
	promptTokens int64 `json:"promptTokens"`
	completionTokens int64 `json:"completionTokens"`
	totalTokens int64 `json:"totalTokens"`
	callCount int64 `json:"callCount"`
}

@server (
	group: ai_llmops
	prefix: /api/v1/ai
	middleware: AuthMiddleware,CasbinMiddleware
)
service gateway {
	// 查询指定 traceId 的 LLM 调用链路。
	@handler aiGetLlmTrace
	get /llm/traces/:traceId (AiLlmTracePathReq) returns (AiLlmTraceResp)

	// 分页查询 LLM 调用日志。
	@handler aiListLlmCall
	get /llm/calls (AiListLlmCallReq) returns (AiListLlmCallResp)

	// 查询当前用户在指定范围内的 token 用量统计。
	@handler aiGetTokenStats
	get /llm/token-stats (AiTokenStatsReq) returns (AiTokenStatsResp)
}
